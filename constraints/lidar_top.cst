// =====================================================================
// lidar_top.cst  -  asignacion de pines para la Tang Nano 9K
// (sistema con sensor; el HDMI se agrega despues)
//
// Numeros de pin segun el esquematico de Sipeed de la Tang Nano 9K.
// Antes de conectar, confirmenlos con la imagen de pines de la tarjeta.
// =====================================================================

// ---- reloj: oscilador de 27 MHz de la tarjeta ----
IO_LOC  "clk_27" 52;
IO_PORT "clk_27" PULL_MODE=UP;

// ---- pulsadores de la tarjeta (activos en bajo) ----
IO_LOC  "btn_s1" 4;   // en la tarjeta S1 y S2 estaban invertidos
IO_PORT "btn_s1" PULL_MODE=UP;
IO_LOC  "btn_s2" 3;
IO_PORT "btn_s2" PULL_MODE=UP;

// ---- LEDs de la tarjeta (activos en bajo: 0 = encendido) ----
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8;

// ---- senales de los servos (pines del conector lateral, 3,3 V) ----
IO_LOC  "pwm_pan"  25;
IO_PORT "pwm_pan"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "pwm_tilt" 26;
IO_PORT "pwm_tilt" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---- sensor HC-SR04 (pines del conector lateral, 3,3 V) ----
// trig: 3,3 V basta para el HC-SR04.
// echo: el sensor entrega 5 V -> divisor 1 kOhm (serie) / 2 kOhm (a GND) = 3,3 V.
IO_LOC  "trig" 27;
IO_PORT "trig" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "echo" 28;
IO_PORT "echo" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
